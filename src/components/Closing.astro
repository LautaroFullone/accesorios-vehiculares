---
import { copy, messages, waLink } from '../data/business';
import { cierre } from '../data/imagenes';

const { image } = copy.close;
const turnoHref = waLink(messages.turno);
---

<section id="cierre" class="close" aria-labelledby="close-title">
	<div class="close-media">
		<picture>
			<source
				media="(min-width: 800px)"
				srcset={cierre.desktop.srcSet.attribute}
				sizes="(min-width: 800px) min(70vw, 60rem)"
				width="1536"
				height="1024"
			/>
			<img
				src={cierre.mobile.src}
				srcset={cierre.mobile.srcSet.attribute}
				sizes="100vw"
				width="1024"
				height="1536"
				alt={image.alt}
				loading="lazy"
				decoding="async"
			/>
		</picture>
	</div>
	<div class="close-inner">
		<h2 id="close-title">{copy.close.title}</h2>
		<a class="btn" href={turnoHref} rel="noopener">{copy.close.cta}</a>
	</div>
</section>
